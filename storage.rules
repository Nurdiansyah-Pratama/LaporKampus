rules_version = '2';

// Aturan Keamanan Firebase Storage untuk aplikasi LaporKampus
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidImageUpload() {
      return request.resource != null
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Foto bukti awal laporan dari Mahasiswa
    match /report_photos/{reportId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidImageUpload();
    }

    // Foto bukti penyelesaian perbaikan dari Teknisi / Satgas
    match /completion_photos/{reportId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidImageUpload();
    }

    // Tolak semua akses di luar jalur resmi
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
